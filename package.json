{
  "name": "arcdb",
  "version": "0.1.0",
  "private": true,
  "description": "The output lifecycle database for autonomous agents.",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:contract": "turbo run test:contract",
    "test:integration": "turbo run test:integration",
    "test:fault": "turbo run test:fault",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env --import tsx packages/db/src/cli/migrate.ts",
    "db:seed": "pnpm --filter @arcdb/db seed",
    "demo:sql-agent": "pnpm exec turbo run build --filter=@arcdb/example-sql-change-agent 1>&2 && node --env-file-if-exists=.env examples/sql-change-agent/dist/main.js",
    "bench:arcbench": "pnpm exec turbo run build --filter=@arcdb/arcbench 1>&2 && node benchmarks/arcbench/dist/cli.js",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "1.62.1",
    "tsx": "4.23.12",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  }
}
