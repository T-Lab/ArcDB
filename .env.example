# Local development only. Replace every value before deploying ArcDB.
NODE_ENV=development
ARCDB_LOG_LEVEL=info
ARCDB_PUBLIC_URL=http://localhost:3000
ARCDB_API_PUBLIC_URL=http://localhost:4000
ARCDB_API_URL=http://localhost:4000
NEXT_PUBLIC_ARCDB_API_URL=http://localhost:4000
# Compose publishes every development port on loopback unless explicitly overridden.
ARCDB_BIND_ADDRESS=127.0.0.1
# Outer operator-console credential. Production Web fails closed without both values.
ARCDB_CONSOLE_USERNAME=arcdb
ARCDB_CONSOLE_PASSWORD=arcdb_console_local_only
# Runtime services use the constrained application role. Migration and seed commands
# automatically prefer ARCDB_ADMIN_DATABASE_URL.
ARCDB_POSTGRES_ADMIN_USER=arcdb_admin
ARCDB_POSTGRES_ADMIN_PASSWORD=arcdb_admin_local_only
ARCDB_POSTGRES_APP_USER=arcdb_app
ARCDB_POSTGRES_APP_PASSWORD=arcdb_app_local_only
ARCDB_POSTGRES_SYSTEM_USER=arcdb_system
ARCDB_POSTGRES_SYSTEM_PASSWORD=arcdb_system_local_only
ARCDB_ADMIN_DATABASE_URL=postgresql://arcdb_admin:arcdb_admin_local_only@localhost:5432/arcdb
ARCDB_DATABASE_URL=postgresql://arcdb_app:arcdb_app_local_only@localhost:5432/arcdb
ARCDB_SYSTEM_DATABASE_URL=postgresql://arcdb_system:arcdb_system_local_only@localhost:5432/arcdb
ARCDB_REDIS_URL=redis://localhost:6379
ARCDB_S3_ENDPOINT=http://localhost:9000
ARCDB_S3_REGION=us-east-1
ARCDB_S3_BUCKET=arcdb-artifacts
ARCDB_S3_ACCESS_KEY=arcdb
ARCDB_S3_SECRET_KEY=arcdb_local_only
ARCDB_S3_FORCE_PATH_STYLE=true
# The bootstrap key is accepted only when ARCDB_ALLOW_DEV_BOOTSTRAP=true.
ARCDB_ALLOW_DEV_BOOTSTRAP=true
# Comma-separated and server-validated. v0.1 registers only the non-writing manual-receipt connector.
ARCDB_ALLOWED_CONNECTORS=manual-receipt
ARCDB_BOOTSTRAP_API_KEY=arcdb_dev_change_me_32_characters
ARCDB_API_KEY=arcdb_dev_change_me_32_characters
# Printed by `pnpm db:seed`; the default deterministic local seed is documented in the quickstart.
ARCDB_PROJECT_ID=019c91e8-43a6-7ec0-a000-000000000002
ARCDB_BOOTSTRAP_ORGANIZATION=ArcDB Local
ARCDB_BOOTSTRAP_PROJECT=SQL Change Agent
